# Web Server Port (start the tool with: npm start)
PORT=3000

# How many mysqldump processes pull table groups at the same time (1-8, default 4).
# Faster over a slow link; use 1 for one single consistent snapshot of the whole database.
DUMP_PARALLEL=4

# Each system has its OWN production database server.
# <PREFIX>_PMA_URL is only used as a fallback when port 3306 is not reachable.
# LOCAL_<PREFIX>_CENTRAL_DB is the central (tenants/domains) database on your local MySQL.
#
# Old single-server keys (PROD_DB_USERNAME, PROD_DB_PASSWORD, PROD_DB_PORT, PROD_DB_LMS,
# PROD_DB_TMS, LOCAL_DB_LMS, LOCAL_DB_TMS, PMA_BASE_URL) are still read as a fallback.

# TMS Training -> DBServer-TMS
TMS_DB_HOST=134.209.94.38
TMS_DB_PORT=3306
TMS_DB_USERNAME=admin
TMS_DB_PASSWORD=your_tms_password_here
TMS_CENTRAL_DB=alamlms_tenancy
TMS_PMA_URL=https://lms.alamlms.com/db_access
LOCAL_TMS_CENTRAL_DB=alamlms_tenancy
LOCAL_TMS_APP_PORT=

# LMS School -> DBServer-LMS
LMS_DB_HOST=64.225.66.108
LMS_DB_PORT=3306
LMS_DB_USERNAME=admin
LMS_DB_PASSWORD=your_lms_password_here
LMS_CENTRAL_DB=alamlms
LMS_PMA_URL=https://phpmyadmin-lms.alamlms.com
LOCAL_LMS_CENTRAL_DB=alamlms
LOCAL_LMS_APP_PORT=

# CMS Sites -> same DB server as LMS (DBServer-LMS)
CMS_DB_HOST=64.225.66.108
CMS_DB_PORT=3306
CMS_DB_USERNAME=admin
CMS_DB_PASSWORD=your_lms_password_here
CMS_CENTRAL_DB=alamlms_sites
CMS_PMA_URL=https://phpmyadmin-lms.alamlms.com
LOCAL_CMS_CENTRAL_DB=alamlms_sites
# Local CMS runs in Docker on :8080 (CMS/docker-compose.yml)
LOCAL_CMS_APP_PORT=8080

# Local MySQL
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=

# MySQL client binaries
# Windows (Laragon): full path to mysql.exe / mysqldump.exe
# Linux/macOS: "mysql" / "mysqldump" (looked up in PATH), or a full path like /usr/bin/mysql
# If the configured path does not exist, the tool auto-detects the binary from PATH.
MYSQL_BIN_PATH="C:\laragon\bin\mysql\mysql-8.0.30-winx64\bin\mysql.exe"
MYSQLDUMP_BIN_PATH="C:\laragon\bin\mysql\mysql-8.0.30-winx64\bin\mysqldump.exe"
